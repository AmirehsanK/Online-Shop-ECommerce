<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>online-shop-web</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\IOC\IOC.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    </ItemGroup>

    <ItemGroup>
        <_ContentIncludedByDefault Remove="Views\Shared\Components\Subjects\Default.cshtml" />
        <_ContentIncludedByDefault Remove="Views\Components\ContactUs.cshtml\Default.cshtml" />
        <_ContentIncludedByDefault Remove="Views\Shared\Components\BotLeftSliderBanner\Default.cshtml" />
        <_ContentIncludedByDefault Remove="Views\Shared\Components\BotRightBanner\Default.cshtml" />
        <_ContentIncludedByDefault Remove="Views\Shared\Components\BotSliderLeftBanner\Default.cshtml" />
        <_ContentIncludedByDefault Remove="Views\Shared\Components\BotSliderRightBanner\Default.cshtml" />
        <_ContentIncludedByDefault Remove="Views\Shared\Components\TopClosableBanner\Default.cshtml" />
        <_ContentIncludedByDefault Remove="Views\Shared\Components\TopLeftSliderBanner\Default.cshtml" />
        <_ContentIncludedByDefault Remove="Views\Shared\Components\TopSecondBanner\Default.cshtml" />
    </ItemGroup>

</Project>
